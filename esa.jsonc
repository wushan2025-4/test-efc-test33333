{
  "name": "vite-vue-template",
  "installCommand": "npm install",
  "assets": {
    "directory": "./dist",
    "notFoundStrategy": "singlePageApplication"
  }，
"regionFunction": {
    // 函数规格，基础版固定为 1c2g
    "instanceType": "2c4g",
    // 每个部署区域的最小实例数
    //"minInstances": 1,
    // 单实例可同时执行的请求数
    //"concurrency": 200,
    "timeout": 600,
  "idleTimeout": 600
  }
}
